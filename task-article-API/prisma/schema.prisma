generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  author      String
  category    String
  publishedAt DateTime  @default(now())
  comments    Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  body      String
  article   Article  @relation(fields: [articleId], references: [id])
  articleId Int
  createdAt DateTime @default(now())
}