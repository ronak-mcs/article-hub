<% block('HeaderCss') %>
<!-- Tailwind & Fonts -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<% layout('layouts/main') %>

<% block('breadcrumb') %>
<%- block('body') %>

<!-- Main Content -->
<div class="md:ml-64 p-4 bg-gray-100 min-h-screen pb-20 md:pb-0 ">
  <form id="display_Logger" enctype="multipart/form-data" class="space-y-6">

    <!-- Header -->

    <div class="flex justify-between items-center mb-6">
      <h4 class="text-xl font-bold text-gray-800  py-2">Admin API Logger Files</h4>

    </div>
    <!-- Logger Files Grid -->
    <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
      <% if (logData?.length) { %>
      <% logData.forEach(item=> { %>
      <div class="bg-white rounded-lg shadow-md p-4 flex flex-col items-center justify-between h-full">

        <!-- File Icon -->
        <div class="text-gray-800 text-3xl mb-3">
          <i class="fas fa-file-alt"></i>
        </div>

        <!-- File Name -->
        <h6 class="font-medium text-center text-gray-700 text-sm truncate w-full">
          <%= item %>
        </h6>

        <!-- Action Buttons -->
        <div class="flex gap-2 mt-4">
          <button type="button" class="px-2 py-1 text-xs border border-green-600 text-green-600 rounded hover:bg-green-50" onclick="downloadFile(event, '<%= item %>')">
            Download
          </button>
          <button type="button" class="px-2 py-1 text-xs border border-red-600 text-red-600 rounded hover:bg-red-50" onclick="showConfirmationPopup('<%= item %>')">
            <i class="fas fa-trash-alt"></i>
          </button>
        </div>
      </div>
      <% }) %>
      <% } else { %>
      <div class="col-span-full">
        <p class="text-red-500 font-semibold text-center">No logger files found!</p>
      </div>
      <% } %>
    </div>
  </form>
</div>

<!-- Popup Modal for Information -->
<div id="popupModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm flex items-center justify-center">
  <div class="bg-white p-6 rounded-lg shadow-lg max-w-sm w-full text-center">
    <h2 id="popupTitle" class="text-xl font-bold mb-2"></h2>
    <p id="popupMessage" class="text-gray-700 mb-4"></p>
    <button id="popupOkBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
      OK
    </button>
  </div>
</div>

<!-- Popup Modal for Delete Confirmation -->
<div id="confirmationModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm flex items-center justify-center">
  <div class="bg-white p-6 rounded-lg shadow-lg max-w-sm w-full text-center">
    <h2 id="confirmationTitle" class="text-xl font-bold mb-2">Are you sure?</h2>
    <p id="confirmationMessage" class="text-gray-700 mb-4">Are you sure you want to delete this file?</p>
    <div class="flex justify-around">
      <button id="confirmDeleteBtn" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">
        Yes, Delete
      </button>
      <button id="cancelDeleteBtn" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-700">
        No, Cancel
      </button>
    </div>
  </div>
</div>

<!-- Scripts -->
<%- block('FooterJs') %>
<%- block('BottomJs') %>
<script>
  let shouldReloadAfterPopup = false; // Track whether to refresh
  let fileToDelete = null;

  function showPopup(title, message, reload = false) {
    document.getElementById('popupTitle').innerText = title;
    document.getElementById('popupMessage').innerText = message;
    shouldReloadAfterPopup = reload;
    document.getElementById('popupModal').classList.remove('hidden');
  }

  // Click handler for OK button
  document.getElementById('popupOkBtn').addEventListener('click', function() {
    document.getElementById('popupModal').classList.add('hidden');
    if (shouldReloadAfterPopup) {
      location.reload();
    }
  });

  // Function to show the confirmation modal
  function showConfirmationPopup(fileName) {
    fileToDelete = fileName;
    document.getElementById('confirmationModal').classList.remove('hidden');
  }

  // Event listener for confirming delete
  document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
    if (fileToDelete) {
      deleteFile(fileToDelete); // Proceed with deletion
    }
    document.getElementById('confirmationModal').classList.add('hidden');
  });

  // Event listener for canceling delete
  document.getElementById('cancelDeleteBtn').addEventListener('click', function() {
    document.getElementById('confirmationModal').classList.add('hidden'); // Close the modal without deletion
  });

  // Function to delete the file
  function deleteFile(fileName) {
    fetch('/v1/logger-file/delete-admin-logger', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          filename: fileName
        })
      })
      .then(response => {
        if (response.ok) {
          showPopup('File Deleted', 'File deleted successfully', true); // reload after OK
        } else {
          showPopup('Delete Failed', 'Failed to delete the file');
        }
      })
      .catch(error => {
        console.error(error);
        showPopup('Error', 'Error deleting file');
      });
  }

  function downloadFile(event, fileName) {
    event.preventDefault();
    const url = `v1/logger-file/admin-view-logger-list/${fileName}`;
    fetch(url)
      .then(response => {
        if (!response.ok) throw new Error(`Download failed`);
        return response.blob();
      })
      .then(blob => {
        const a = document.createElement('a');
        a.href = window.URL.createObjectURL(blob);
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        showPopup('Download Complete', 'File downloaded successfully');
      })
      .catch(error => {
        showPopup('Download Error', error.message);
      });
  }
</script>
</%- block('FooterJs') %>
</%- block('BottomJs') %>