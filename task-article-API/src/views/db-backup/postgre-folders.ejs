<% block('HeaderCss') %>
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<% layout('layouts/main') %>

<% block('breadcrumb') %>
<%- block('body') %>

<div class="md:ml-64 p-4 bg-gray-100 pb-20 md:pb-0 min-h-screen">
  <form id="display_Logger" action="/db-backup" method="get" enctype="multipart/form-data" class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
      <h4 class="text-xl font-bold text-gray-800">Database Backup Details</h4>
      <button type="button" id="backup" class="bg-gray-800 text-white px-4 py-2 rounded hover:bg-gray-700" onclick="generateBackup()">
        Generate Backup
      </button>
    </div>

    <!-- Backup Folders -->
    <div class="grid gap-4  sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
      <% const backupFolders=folder || []; %>
      <% if (backupFolders?.length) { %>
      <% backupFolders.forEach(item=> { %>
      <div class="bg-white rounded-lg shadow-md p-4 flex flex-col items-center justify-between h-full">
        <div class="text-gray-800 text-3xl mb-3">
          <i class="fas fa-database"></i>
        </div>
        <h6 class="font-medium text-center text-gray-700 text-sm truncate w-full">
          <%= item %>
        </h6>
        <div class="flex gap-2 mt-4">
          <button type="button" class="px-2 py-1 text-xs border border-green-600 text-green-600 rounded hover:bg-green-50" onclick="getZipFolder('<%= item %>')">
            Download
          </button>
          <button type="button" class="px-2 py-1 text-xs border border-red-600 text-red-600 rounded hover:bg-red-50" onclick="deleteFile('<%= item %>')">
            <i class="fas fa-trash-alt"></i>
          </button>
        </div>
      </div>
      <% }) %>
      <% } else { %>
      <div class="col-span-full">
        <p class="text-red-500 font-semibold text-center">No backup folders found!</p>
      </div>
      <% } %>
    </div>
  </form>
</div>

<!-- Fullscreen Blur Overlay -->

<!-- Spinner Modal -->
<div id="dbBackup" class="fixed inset-0 z-[9999999] bg-black bg-opacity-50 hidden flex items-center backdrop-blur-sm justify-center pointer-events-auto">
  <div class="bg-white rounded-lg p-6 max-w-sm mx-auto text-center">
    <lottie-player id="spinner" src="https://assets5.lottiefiles.com/packages/lf20_YytgWL.json" background="transparent" speed="1" style="width: 150px; height: 150px; margin: auto;" loop autoplay>
    </lottie-player>
    <p class="font-semibold mt-4 text-gray-800">Please wait until the backup is generated...</p>
    <p class="text-red-500 text-sm mt-1">Do not press back or refresh the page while data is fetching.</p>
  </div>
</div>

<!-- Simple Alert Modal -->
<div id="alertModal" class="fixed inset-0 z-[9999999] hidden bg-black bg-opacity-50  backdrop-blur-sm flex items-center justify-center pointer-events-auto">
  <div class="bg-white p-6 rounded shadow-lg max-w-sm w-full text-center">
    <h2 id="alertTitle" class="text-xl font-bold mb-2"></h2>
    <p id="alertMessage" class="text-gray-700 mb-4"></p>
    <button onclick="closeAlertModal()" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
      OK
    </button>
  </div>
</div>

<!-- Confirmation Modal for Deletion -->
<div id="confirmationModal" class="fixed inset-0 z-[9999999] hidden bg-black bg-opacity-50 backdrop-blur-sm flex items-center justify-center pointer-events-auto">
  <div class="bg-white p-6 rounded-lg shadow-lg max-w-sm w-full text-center">
    <h2 id="confirmationTitle" class="text-xl font-bold mb-2">Are you sure?</h2>
    <p id="confirmationMessage" class="text-gray-700 mb-4">Are you sure you want to delete this folder?</p>
    <div class="flex justify-around">
      <button id="confirmDeleteBtn" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">
        Yes, Delete
      </button>
      <button id="cancelDeleteBtn" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-700">
        No, Cancel
      </button>
    </div>
  </div>
</div>

<%- block('FooterJs') %>
<%- block('BottomJs') %>
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>

<script>
  let folderToDelete = null;

  // Function to show the confirmation modal
  function showConfirmationPopup(folderName) {
    folderToDelete = folderName;
    document.getElementById('confirmationModal').classList.remove('hidden');
  }

  // Event listener for confirming the delete
  document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
    if (folderToDelete) {
      deleteConfirmedFile(folderToDelete); // Proceed with the deletion if confirmed
    }
    document.getElementById('confirmationModal').classList.add('hidden');
  });

  // Event listener for canceling the delete
  document.getElementById('cancelDeleteBtn').addEventListener('click', function() {
    document.getElementById('confirmationModal').classList.add('hidden'); // Close the modal without deletion
  });

  // Function to show the alert modal
  function showAlert(title, message, reload = false) {
    document.getElementById('alertTitle').innerText = title;
    document.getElementById('alertMessage').innerText = message;

    // Show the blur overlay and modal
    document.getElementById('alertModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden'; // Disable scrolling

    window._reloadAfterClose = reload;
  }

  function closeAlertModal() {
    document.getElementById('alertModal').classList.add('hidden');
    document.body.style.overflow = ''; // Re-enable scrolling

    if (window._reloadAfterClose) {
      window.location.reload();
    }
  }

  function generateBackup() {
    document.getElementById('dbBackup').classList.remove('hidden');
    document.body.style.overflow = 'hidden'; // Disable scrolling

    fetch('/v1/backup/create', {
        method: 'GET'
      })
      .then(response => {
        document.getElementById('dbBackup').classList.add('hidden');
        document.body.style.overflow = ''; // Re-enable scrolling

        if (response.ok) {
          showAlert('Backup Generated Successful', 'Your database backup has been generated.', true);
        } else {
          showAlert('Error', 'Failed to generate the backup.', true);
        }
      })
      .catch(error => {
        console.error('Generate Error:', error);
        document.getElementById('dbBackup').classList.add('hidden');
        document.body.style.overflow = ''; // Re-enable scrolling
        showAlert('Error', 'Something went wrong during backup.', true);
      });
  }

  function getZipFolder(folderName) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/v1/download-postgresql-backup-folder';

    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'folder_name';
    input.value = folderName;
    form.appendChild(input);

    document.body.appendChild(form);
    form.submit();
    document.body.removeChild(form);

    showAlert('Download Started', `The backup "${folderName}" is downloading.`, false);
  }

  function deleteFile(folderName) {
    showConfirmationPopup(folderName); // Show the confirmation popup
  }

  function deleteConfirmedFile(folderName) {
    fetch('/v1/delete-backup', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          folder_name: folderName
        })
      })
      .then(response => {
        if (response.ok) {
          showAlert('Deleted', `Backup folder "${folderName}" deleted successfully.`, true);
        } else {
          showAlert('Error', 'Failed to delete the folder.', true);
        }
      })
      .catch(error => {
        console.error('Delete Error:', error);
        showAlert('Error', 'Something went wrong while deleting.', true);
      });
  }
</script>